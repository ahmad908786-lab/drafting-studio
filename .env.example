# ---------------------------------------------------------------
# Drafting Studio — environment variables
# Copy to .env for local dev. In production set these in
# Hostinger → Websites → draftingstudio.org → Environment variables.
# ---------------------------------------------------------------

# MySQL (Hostinger). Host = the "MySQL host" shown on Databases → Remote MySQL.
# connection_limit keeps the build (many parallel workers) under Hostinger's
# per-user connection cap. URL-encode special characters in the password.
DATABASE_URL="mysql://u442793684_drafting:PASSWORD@HOST:3306/u442793684_drafting?connection_limit=5"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://draftingstudio.org"

# Inlined at BUILD time — must be set before the build runs.
NEXT_PUBLIC_SITE_URL="https://draftingstudio.org"

# Real admin login. On every build the seeded demo logins are disabled and
# this account is (re)set, so /admin isn't open with the README passwords.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Mail (optional — without it, messages are logged instead of sent)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
LEADS_INBOX=""

# Google sign-in (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
